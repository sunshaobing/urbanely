                    "NSCameraUsageDescription" : "用于拍摄现场服务照片和手写签字确认。",
                    "NSPhotoLibraryUsageDescription" : "用于选择现场服务照片并上传至服务报告。"
                }
            },
            /* SDK配置 */
            "sdkConfigs" : {},
            "icons" : {
                "android" : {
                    "hdpi" : "src/static/icons/app-72.png",
                    "xhdpi" : "src/static/icons/app-96.png",
                    "xxhdpi" : "src/static/icons/app-144.png",
                    "xxxhdpi" : "src/static/icons/app-192.png"
                },
                "ios" : {
                    "appstore" : "src/static/icons/app-1024.png"
