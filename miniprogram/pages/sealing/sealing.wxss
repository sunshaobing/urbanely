.info-list {
  margin-top: 14rpx;
}

.hint-card,
.signature-note {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #e6f4f0;
  color: #0a5b55;
}

.hint-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
}

.hint-text {
  display: block;
  margin-top: 5rpx;
  color: #4a6259;
  font-size: 21rpx;
  line-height: 1.55;
}

.sealing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0ed;
}

.sealing-row:last-child {
  border-bottom: 0;
}

.sealing-row-copy {
  min-width: 0;
}

.sealing-location {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.sealing-hole {
  display: block;
  margin-top: 4rpx;
  color: #6b7771;
  font-size: 20rpx;
}

.material-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0ed;
}

.material-row:last-child {
  border-bottom: 0;
}

.material-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.material-spec {
  display: block;
  margin-top: 3rpx;
  color: #6b7771;
  font-size: 20rpx;
}

.material-qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6b7771;
  font-size: 20rpx;
}

.material-qty input {
  width: 90rpx;
  height: 54rpx;
  padding: 0 12rpx;
  border: 1rpx solid #dde3df;
  border-radius: 8rpx;
  text-align: center;
  font-size: 22rpx;
}

.link-btn {
  color: #0f766e;
  font-size: 21rpx;
}

.offline-note {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #6b7771;
  font-size: 20rpx;
}

.offline-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b45309;
}

.save-draft {
  width: 150rpx;
  padding: 0;
}
