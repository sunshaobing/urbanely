<view class="login-page">
  <view class="login-header">
    <view class="login-brand">
      <view class="login-logo">ST</view>
      <view>
        <text class="login-brand-name">申汰封堵勘测</text>
        <text class="login-brand-sub">FIELD INSPECTION</text>
      </view>
    </view>
    <text class="login-heading">封堵勘测工作台</text>
    <text class="login-description">现场任务、封堵记录与验收状态统一管理。</text>
  </view>

  <view class="login-body">
    <view class="login-card">
      <text class="form-title">账号登录</text>
      <text class="form-sub">使用已授权手机号登录</text>

      <view class="field">
        <text class="field-label">手机号码</text>
        <view class="login-input-wrap">
          <text class="login-prefix">+86</text>
          <input
            class="login-input"
            type="number"
            maxlength="11"
            value="{{phone}}"
            placeholder="请输入 11 位手机号码"
            bindinput="onPhoneInput"
          />
        </view>
      </view>

      <view class="field">
        <text class="field-label">密码</text>
        <view class="login-input-wrap">
          <input
            class="login-input"
            password="{{!showPassword}}"
            value="{{password}}"
            placeholder="请输入密码"
            bindinput="onPasswordInput"
          />
          <text class="login-eye" bindtap="togglePassword">{{showPassword ? "隐藏" : "显示"}}</text>
        </view>
      </view>

      <view wx:if="{{error}}" class="login-error">{{error}}</view>

      <button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="login">登录</button>
      <view class="login-links">
        <text class="login-link" bindtap="forgotPassword">忘记密码</text>
        <text class="login-security">腾讯云服务</text>
      </view>
    </view>

    <text class="login-foot">上海申汰实业有限公司 · 内部作业系统</text>
  </view>
</view>
