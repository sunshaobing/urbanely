<view class="login-page">
  <view class="login-hero">
    <view class="login-brand">
      <view class="login-logo">申</view>
      <view>
        <text class="login-brand-name">申汰 PCO</text>
        <text class="login-brand-sub">FIELD OPERATIONS</text>
      </view>
    </view>
    <text class="login-title">让每一次现场服务，都有证据可循。</text>
    <text class="login-sub">勘测、封堵、复检、签字和报告，在一条业务链里完成。</text>
    <view class="login-stats">
      <view class="login-stat"><text class="login-stat-value">186</text><text class="login-stat-label">客户项目</text></view>
      <view class="login-stat"><text class="login-stat-value">195</text><text class="login-stat-label">服务单</text></view>
      <view class="login-stat"><text class="login-stat-value">92.4%</text><text class="login-stat-label">封堵闭环</text></view>
    </view>
  </view>

  <view class="login-body">
    <view class="login-card">
      <text class="eyebrow">SECURE ACCESS</text>
      <text class="login-card-title">登录现场端</text>
      <text class="login-card-sub">使用工程师手机号登录，进入今日作业。</text>

      <view class="field">
        <text class="field-label">手机号码</text>
        <view class="login-input-wrap">
          <text class="login-prefix">+86</text>
          <input
            class="login-input"
            type="number"
            maxlength="11"
            value="{{phone}}"
            placeholder="请输入 11 位手机号码"
            bindinput="onPhoneInput"
          />
        </view>
      </view>

      <view class="field">
        <text class="field-label">密码</text>
        <view class="login-input-wrap">
          <input
            class="login-input"
            password="{{!showPassword}}"
            value="{{password}}"
            placeholder="请输入密码"
            bindinput="onPasswordInput"
          />
          <text class="login-eye" bindtap="togglePassword">{{showPassword ? "隐藏" : "显示"}}</text>
        </view>
      </view>

      <view wx:if="{{error}}" class="login-error">{{error}}</view>

      <button class="login-button" loading="{{loading}}" bindtap="login">登录</button>
      <view class="login-links">
        <text class="login-link" bindtap="forgotPassword">忘记密码</text>
        <text class="login-demo">演示环境 · 数据为脱敏样例</text>
      </view>
    </view>
    <text class="login-foot">上海申汰实业有限公司 · 内部运营系统</text>
  </view>
</view>
