.login-page {
  min-height: 100vh;
  background: #f5f7f6;
  color: #18201d;
}

.login-header {
  padding: 48rpx 32rpx 40rpx;
  border-bottom: 1rpx solid #e8ecea;
  background: #ffffff;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.login-logo {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #17211f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.login-brand-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.login-brand-sub {
  display: block;
  margin-top: 16rpx;
  color: #7a8580;
  font-size: 24rpx;
}

.login-heading {
  display: block;
  margin-top: 48rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.login-description {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-body {
  padding: 32rpx;
}

.login-card {
  padding: 32rpx;
  border: 1rpx solid #e8ecea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.form-sub {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
}

.login-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe5e2;
  border-radius: 16rpx;
  background: #ffffff;
}

.login-prefix {
  padding-right: 16rpx;
  border-right: 1rpx solid #dfe5e2;
  color: #4f5b56;
  font-size: 24rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 28rpx;
}

.login-eye {
  flex: none;
  color: #0f6b5c;
  font-size: 24rpx;
}

.login-error {
  margin-top: 16rpx;
  color: #9a3f3b;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 80rpx;
  margin-top: 32rpx;
  border-radius: 16rpx;
  background: #17211f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.login-button[disabled] {
  opacity: 0.56;
}

.login-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.login-link {
  color: #0f6b5c;
  font-size: 24rpx;
}

.login-security {
  color: #8a938f;
  font-size: 24rpx;
}

.login-foot {
  display: block;
  margin-top: 32rpx;
  color: #8a938f;
  font-size: 24rpx;
  text-align: center;
}
