.login-page {
  min-height: 100vh;
  background: #f4f5f2;
}

.login-hero {
  padding: 54rpx 38rpx 48rpx;
  background: #14201c;
  color: #eef6f1;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.login-logo {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #0f766e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.login-brand-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.login-brand-sub {
  display: block;
  margin-top: 2rpx;
  color: #8fa299;
  font-size: 18rpx;
  letter-spacing: 0;
}

.login-title {
  display: block;
  margin-top: 42rpx;
  max-width: 620rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.28;
}

.login-sub {
  display: block;
  margin-top: 14rpx;
  color: #a9b8b0;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-stats {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.login-stat {
  flex: 1;
}

.login-stat-value {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.login-stat-label {
  display: block;
  margin-top: 2rpx;
  color: #8fa299;
  font-size: 19rpx;
}

.login-body {
  padding: 28rpx 28rpx 44rpx;
}

.login-card {
  padding: 32rpx 28rpx;
  border: 1rpx solid #dde3df;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(23, 32, 29, 0.06);
}

.login-card-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.login-card-sub {
  display: block;
  margin-top: 6rpx;
  color: #6b7771;
  font-size: 22rpx;
}

.login-input-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 86rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dde3df;
  border-radius: 12rpx;
  background: #fff;
}

.login-prefix {
  padding-right: 14rpx;
  border-right: 1rpx solid #dde3df;
  color: #35433d;
  font-size: 24rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 26rpx;
}

.login-eye {
  flex: none;
  color: #0f766e;
  font-size: 21rpx;
}

.login-error {
  margin-top: 16rpx;
  color: #b42318;
  font-size: 21rpx;
}

.login-button {
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 14rpx;
  background: #0f766e;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.login-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 18rpx;
}

.login-link {
  color: #0f766e;
  font-size: 21rpx;
}

.login-demo {
  color: #9aa59f;
  font-size: 19rpx;
}

.login-foot {
  display: block;
  margin-top: 22rpx;
  color: #9aa59f;
  font-size: 19rpx;
  text-align: center;
}
