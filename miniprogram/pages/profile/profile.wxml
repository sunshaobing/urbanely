<view class="profile-page">
  <view class="profile-header">
    <image class="profile-avatar" src="/assets/avatar-technician.png" mode="aspectFill" />
    <view class="profile-copy">
      <text class="profile-name">{{user.name || user.username || "现场人员"}}</text>
      <text class="profile-role">{{user.role || "外勤人员"}}</text>
      <text class="profile-meta">{{user.username}} · {{user.phoneMasked}}</text>
    </view>
  </view>

  <view class="profile-content">
    <view wx:if="{{loading && metrics.length === 0}}" class="state-card">
      <text class="state-title">正在加载</text>
      <text class="state-copy">账号数据加载中。</text>
    </view>

    <view wx:elif="{{error}}" class="state-card">
      <text class="state-title">数据未加载</text>
      <text class="state-copy">{{error}}</text>
      <button class="retry-button" bindtap="refresh">重新加载</button>
    </view>

    <view wx:else class="metric-grid">
      <view class="metric-card" wx:for="{{metrics}}" wx:key="label">
        <text class="metric-value">{{loading ? "--" : item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-row" bindtap="about">
        <view class="menu-icon">i</view>
        <view class="menu-copy">
          <text class="menu-title">关于系统</text>
          <text class="menu-sub">封堵勘测小程序</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row danger" bindtap="logout">
        <view class="menu-icon">↪</view>
        <view class="menu-copy">
          <text class="menu-title">退出登录</text>
          <text class="menu-sub">清除当前账号会话</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <bottom-nav current="profile" />
</view>
