<view class="page-shell">
  <view class="hero profile-hero">
    <view class="profile-head">
      <image class="profile-avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view class="profile-copy">
        <text class="profile-name">{{user.name}}</text>
        <text class="profile-role">{{user.role}} · {{user.code}}</text>
        <text class="profile-phone">{{user.phoneMasked}}</text>
      </view>
      <text class="pill status-success">已同步</text>
    </view>
    <view class="stat-row">
      <view class="stat"><text class="stat-value">{{queueCount}}</text><text class="stat-label">待同步</text></view>
      <view class="stat"><text class="stat-value">8</text><text class="stat-label">已完成</text></view>
      <view class="stat"><text class="stat-value">92%</text><text class="stat-label">证据完整</text></view>
    </view>
  </view>

  <view class="container">
    <view class="card menu-card">
      <view class="menu-row" bindtap="syncNow">
        <view class="menu-icon">↻</view>
        <view class="menu-copy"><text class="menu-title">同步本机队列</text><text class="menu-sub">{{queueCount}} 项待上传</text></view>
        <text class="menu-arrow">{{syncing ? "同步中" : "›"}}</text>
      </view>
      <view class="menu-row" bindtap="clearCache">
        <view class="menu-icon">◌</view>
        <view class="menu-copy"><text class="menu-title">清理本机缓存</text><text class="menu-sub">删除未提交草稿和同步队列</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="about">
        <view class="menu-icon">i</view>
        <view class="menu-copy"><text class="menu-title">关于系统</text><text class="menu-sub">版本 0.1 · 现场端原型</text></view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row danger" bindtap="logout">
        <view class="menu-icon">↪</view>
        <view class="menu-copy"><text class="menu-title">退出登录</text><text class="menu-sub">清除当前登录会话</text></view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="profile-note">
      <text class="hint-title">现场数据规则</text>
      <text class="hint-text">草稿、照片和签字先保存在本机；正式同步后由服务端归档。生产环境需要把本地文件上传到 COS，并做幂等同步。</text>
    </view>
  </view>

  <bottom-nav current="profile" />
</view>
