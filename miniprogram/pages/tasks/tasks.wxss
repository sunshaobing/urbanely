.workbench-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
  color: #18201d;
}

.workbench-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 32rpx;
  padding: 48rpx 32rpx 32rpx;
  border-bottom: 1rpx solid #e8ecea;
  background: #ffffff;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-kicker {
  display: block;
  color: #0f6b5c;
  font-size: 24rpx;
  font-weight: 600;
}

.page-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.header-meta {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
}

.brand-mark {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #17211f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.workbench-content {
  padding: 32rpx;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.summary-card {
  width: calc(50% - 8rpx);
  padding: 32rpx;
  border: 1rpx solid #e8ecea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.summary-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary-label {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  margin-top: 48rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
}

.refresh-action {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  color: #0f6b5c;
  font-size: 24rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #edf1ef;
}

.filter-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #68736e;
  font-size: 24rpx;
}

.filter-item.active {
  background: #ffffff;
  color: #18201d;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.06);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.task-card {
  padding: 32rpx;
  border: 1rpx solid #e8ecea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-no {
  color: #68736e;
  font-family: "SFMono-Regular", "Cascadia Code", monospace;
  font-size: 24rpx;
}

.task-status {
  flex: none;
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.status-pending {
  background: #fdf1f1;
  color: #9a3f3b;
}

.status-active {
  background: #fff5e8;
  color: #98611a;
}

.status-done {
  background: #eef7f0;
  color: #3f6f4e;
}

.task-customer {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.task-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #4f5b56;
  font-size: 28rpx;
}

.task-address {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
  line-height: 1.5;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #edf0ee;
}

.task-count {
  color: #727d78;
  font-size: 24rpx;
}

.task-link {
  color: #0f6b5c;
  font-size: 28rpx;
  font-weight: 600;
}

.state-card {
  margin-top: 32rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid #e8ecea;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.error-state {
  margin-top: 0;
}

.state-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.state-copy {
  display: block;
  margin-top: 16rpx;
  color: #727d78;
  font-size: 24rpx;
  line-height: 1.6;
}

.retry-button {
  height: 80rpx;
  margin-top: 32rpx;
  border-radius: 16rpx;
  background: #17211f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.loading-line {
  width: 100%;
  height: 24rpx;
  border-radius: 16rpx;
  background: #edf1ef;
}

.loading-line.short {
  width: 50%;
}

.update-note {
  margin-top: 32rpx;
  color: #8a938f;
  font-size: 24rpx;
  text-align: center;
}
