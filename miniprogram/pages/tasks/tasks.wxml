<view class="page-shell">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-brand">
        <image class="nav-avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view>
          <text class="hero-brand-title">早上好，{{user.name}}</text>
          <text class="hero-brand-sub">{{todayLabel}}</text>
        </view>
      </view>
      <view class="hero-status"><view class="status-dot" /><text>已同步</text></view>
    </view>
    <text class="hero-title">今天有 {{stats.today}} 项现场任务</text>
    <text class="hero-sub">优先处理高风险和待提交单据。</text>
    <view class="stat-row">
      <view class="stat"><text class="stat-value">{{stats.today}}</text><text class="stat-label">今日待办</text></view>
      <view class="stat"><text class="stat-value">{{stats.pending}}</text><text class="stat-label">待提交</text></view>
      <view class="stat"><text class="stat-value">{{stats.risk}}</text><text class="stat-label">高风险</text></view>
    </view>
  </view>

  <view class="container">
    <view class="segmented">
      <view
        wx:for="{{filters}}"
        wx:key="*this"
        class="segment {{filter === item ? 'active' : ''}}"
        data-filter="{{item}}"
        bindtap="onFilter"
      >{{item}}</view>
    </view>

    <view class="task-list">
      <view
        wx:for="{{filteredTasks}}"
        wx:key="id"
        class="task-card"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="openTask"
      >
        <view class="task-top">
          <text class="task-time">{{item.time}} · {{item.title}}</text>
          <text class="pill risk-{{item.risk}}">{{item.risk === "critical" ? "极高风险" : item.risk === "high" ? "高风险" : item.risk === "medium" ? "中风险" : "低风险"}}</text>
        </view>
        <text class="task-title">{{item.site.name}}</text>
        <text class="task-site">{{item.site.address}}</text>
        <view class="task-foot">
          <text class="pill {{item.status === '已完成' ? 'status-success' : item.status === '进行中' ? 'status-warning' : 'status-neutral'}}">{{item.status}}</text>
          <text class="task-arrow">进入任务 ›</text>
        </view>
      </view>
      <view wx:if="{{filteredTasks.length === 0}}" class="empty-state">
        <text class="title">今天没有待办任务</text>
        <text class="detail">可以切换到“已完成”查看历史记录。</text>
      </view>
    </view>
  </view>

  <bottom-nav current="tasks" />
</view>
