<view class="workbench-page">
  <view class="workbench-header">
    <view class="header-copy">
      <text class="header-kicker">封堵勘测系统</text>
      <text class="page-title">工作台</text>
      <text class="header-meta">{{dateText}} · {{user.name || user.username || "现场人员"}}</text>
    </view>
    <view class="brand-mark">ST</view>
  </view>

  <view class="workbench-content">
    <view wx:if="{{error}}" class="state-card error-state">
      <text class="state-title">数据未加载</text>
      <text class="state-copy">{{error}}</text>
      <button class="retry-button" bindtap="refresh">重新加载</button>
    </view>

    <block wx:else>
      <view class="summary-grid">
        <view class="summary-card" wx:for="{{summaryCards}}" wx:key="label">
          <text class="summary-value">{{loading ? "--" : item.value}}</text>
          <text class="summary-label">{{item.label}}</text>
        </view>
      </view>

      <view class="section-header">
        <text class="section-title">现场任务</text>
        <text class="refresh-action" bindtap="refresh">{{loading ? "更新中" : "刷新"}}</text>
      </view>

      <view class="filter-bar">
        <view
          wx:for="{{filters}}"
          wx:key="status"
          class="filter-item filter-{{item.tone}} {{activeStatus === item.status ? 'active' : ''}}"
          data-status="{{item.status}}"
          data-label="{{item.label}}"
          bindtap="selectFilter"
        >{{item.label}}</view>
      </view>

      <view wx:if="{{loading && tasks.length === 0}}" class="state-card loading-state">
        <view class="loading-line" />
        <view class="loading-line short" />
        <text class="state-copy">正在加载任务</text>
      </view>

      <view wx:elif="{{tasks.length > 0}}" class="task-list">
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          class="task-card"
          data-id="{{item.id}}"
          bindtap="openTask"
        >
          <view class="task-head">
            <text class="task-no">{{item.report_no}}</text>
            <text class="task-status {{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <text class="task-customer">{{item.customer_name}}</text>
          <view class="task-detail-row">
            <text>{{item.service_type || "结构漏洞封堵"}}</text>
            <text>{{item.displayDate}}</text>
          </view>
          <text class="task-address">{{item.service_address || "地址待补充"}}</text>
          <view class="task-foot">
            <text class="task-count">{{item.siteCount}} 个封堵部位</text>
            <text class="task-link">查看详情</text>
          </view>
        </view>
      </view>

      <view wx:else class="state-card">
        <text class="state-title">暂无{{activeFilterLabel}}任务</text>
        <text class="state-copy">当前筛选下没有任务。</text>
      </view>

      <view wx:if="{{updatedAt}}" class="update-note">最后更新 {{updatedAt}}</view>
    </block>
  </view>

  <bottom-nav current="tasks" />
</view>
