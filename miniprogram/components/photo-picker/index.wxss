.photo-picker {
  padding: 24rpx;
  border: 1rpx solid #dde3df;
  border-radius: 16rpx;
  background: #fff;
}

.photo-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.photo-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.photo-hint {
  display: block;
  margin-top: 4rpx;
  color: #6b7771;
  font-size: 20rpx;
}

.photo-count {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e6f4f0;
  color: #0f766e;
  font-size: 20rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: calc(33.333% - 7rpx);
  height: 194rpx;
  overflow: hidden;
  border-radius: 12rpx;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(20, 32, 28, 0.72);
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx dashed #b8c5be;
  background: #fbfcfa;
  color: #6b7771;
  font-size: 20rpx;
}

.photo-add-icon {
  color: #0f766e;
  font-size: 44rpx;
  line-height: 1;
}
