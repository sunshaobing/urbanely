.bottom-nav {
  position: fixed;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  background: rgba(20, 32, 28, 0.97);
  box-shadow: 0 24rpx 60rpx rgba(23, 32, 29, 0.26);
}

.bottom-nav-item {
  min-width: 150rpx;
  height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 18rpx;
  color: #91a39a;
  font-size: 20rpx;
}

.bottom-nav-item.active {
  background: rgba(15, 118, 110, 0.28);
  color: #fff;
}

.bottom-nav-icon {
  width: 38rpx;
  height: 38rpx;
}
