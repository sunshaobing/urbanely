.bottom-nav {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #17211f;
  box-shadow: 0 16rpx 40rpx rgba(17, 24, 39, 0.2);
}

.bottom-nav-item {
  min-width: 152rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 16rpx;
  color: #8c9692;
  font-size: 24rpx;
}

.bottom-nav-item.active {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  box-shadow: inset 0 -4rpx 0 #fff;
}

.bottom-nav-icon {
  width: 40rpx;
  height: 40rpx;
}
