page {
  background: #f4f5f2;
  color: #17201d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.page-shell.no-nav {
  padding-bottom: 40rpx;
}

.container {
  padding: 28rpx 28rpx 20rpx;
}

.hero {
  padding: 34rpx 28rpx 30rpx;
  color: #eef6f1;
  background: #14201c;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: #0f766e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-brand-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.hero-brand-sub {
  display: block;
  margin-top: 2rpx;
  color: #91a49a;
  font-size: 18rpx;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 30rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-sub {
  margin-top: 8rpx;
  color: #a9b8b0;
  font-size: 24rpx;
}

.hero-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  color: #9fd9cf;
  font-size: 20rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3cc6b7;
}

.stat-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.stat {
  flex: 1;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.045);
}

.stat-value {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  color: #91a49a;
  font-size: 20rpx;
}

.card {
  padding: 26rpx;
  border: 1rpx solid #dde3df;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 29, 0.045);
}

.section {
  margin-top: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.section-sub {
  display: block;
  margin-top: 4rpx;
  color: #6b7771;
  font-size: 22rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #0f766e;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.muted {
  color: #6b7771;
}

.mono {
  font-family: "SFMono-Regular", "Cascadia Code", monospace;
  font-size: 22rpx;
}

.btn-primary,
.btn-secondary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-primary {
  background: #0f766e;
  color: #fff;
}

.btn-primary[disabled] {
  opacity: 0.45;
}

.btn-secondary {
  border: 1rpx solid #dde3df;
  background: #fff;
  color: #35433d;
}

.btn-ghost {
  background: transparent;
  color: #0f766e;
}

.btn-block {
  width: 100%;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.risk-critical {
  background: #f6dcd9;
  color: #8e1b12;
}

.risk-high {
  background: #fdeceb;
  color: #b42318;
}

.risk-medium {
  background: #fdf1df;
  color: #b45309;
}

.risk-low {
  background: #e6f4f0;
  color: #0f766e;
}

.status-success {
  background: #e6f4f0;
  color: #0f766e;
}

.status-warning {
  background: #fdf1df;
  color: #b45309;
}

.status-danger {
  background: #fdeceb;
  color: #b42318;
}

.status-neutral {
  background: #eef1ee;
  color: #6b7771;
}

.segmented {
  display: flex;
  gap: 4rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #ecefec;
}

.segment {
  flex: 1;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #6b7771;
  font-size: 22rpx;
}

.segment.active {
  background: #fff;
  color: #17201d;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 29, 0.08);
}

.task-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #dde3df;
  border-radius: 16rpx;
  background: #fff;
}

.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.task-time {
  color: #6b7771;
  font-size: 22rpx;
}

.task-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.task-site {
  display: block;
  margin-top: 6rpx;
  color: #6b7771;
  font-size: 23rpx;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0ed;
}

.task-arrow {
  color: #0f766e;
  font-size: 24rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dde3df;
  border-radius: 12rpx;
  background: #fff;
  color: #35433d;
  font-size: 22rpx;
}

.chip.active {
  border-color: #9bcfc6;
  background: #e6f4f0;
  color: #0a5b55;
}

.field {
  margin-top: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #6b7771;
  font-size: 21rpx;
}

.input,
.textarea {
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dde3df;
  border-radius: 12rpx;
  background: #fff;
  color: #17201d;
  font-size: 26rpx;
}

.textarea {
  min-height: 200rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf0ed;
  font-size: 24rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row .label {
  flex: none;
  color: #6b7771;
}

.info-row .value {
  text-align: right;
  word-break: break-all;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  background: #14201c;
  color: #fff;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 30rpx;
}

.page-header-copy {
  flex: 1;
  min-width: 0;
}

.page-header-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.page-header-sub {
  display: block;
  margin-top: 2rpx;
  color: #91a49a;
  font-size: 20rpx;
}

.step-bar {
  padding: 20rpx 28rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #dde3df;
}

.step-meta {
  display: flex;
  justify-content: space-between;
  color: #6b7771;
  font-size: 21rpx;
}

.step-track {
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ede9;
}

.step-fill {
  height: 100%;
  border-radius: inherit;
  background: #0f766e;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dde3df;
  background: rgba(255, 255, 255, 0.97);
}

.bottom-actions .btn-secondary {
  width: 180rpx;
}

.bottom-actions .btn-primary {
  flex: 1;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.summary-item {
  width: calc(50% - 7rpx);
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8faf8;
}

.summary-item .label {
  display: block;
  color: #6b7771;
  font-size: 20rpx;
}

.summary-item .value {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-state {
  padding: 60rpx 20rpx;
  color: #6b7771;
  text-align: center;
}

.empty-state .title {
  display: block;
  color: #35433d;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-state .detail {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
